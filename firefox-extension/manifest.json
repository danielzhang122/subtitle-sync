{
  "manifest_version": 3,
  "name": "subtitle-sync",
  "version": "0.2.6",
  "description": "Finds, loads and syncs subtitles for videos on any website automatically, including in picture-in-picture.",
  "browser_specific_settings": {
    "gecko": {
      "id": "subtitle-sync@danielzhang122",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["websiteContent", "authenticationInfo"] }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "webNavigation", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/sync-core.js", "content/audio.js", "content/context.js", "content/video.js", "content/pipbar.js"],
      "css": ["content/cue.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "subtitle-sync",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "commands": {
    "earlier": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Subtitles 0.1 s earlier" },
    "later": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Subtitles 0.1 s later" }
  }
}
